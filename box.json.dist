{
    "main": "bin/toolkit.php",
    "alias": "toolkit.phar",
    "directories": [
        "bin",
        "config",
        "src",
        "vendor"
    ],
    "files": [
        "autoload.php"
    ],
    "compression": "GZ",
    "dump-autoload": false,
    "check-requirements": false,
    "files-bin": [
        "console-table.txt",
        "plain.txt",
        "sbom.json",
        "pkg.composer.txt",
        ".box.manifests.bin"
    ],
    "map": [
        {
            "console-table.txt": ".box.manifests/console-table.txt"
        },
        {
            "plain.txt": ".box.manifests/plain.txt"
        },
        {
            "sbom.json": ".box.manifests/sbom.json"
        },
        {
            "pkg.composer.txt": ".box.manifests/pkg.composer.txt"
        }
    ],
    "stub": "stub.php"
}
